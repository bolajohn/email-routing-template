{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "email-routing-template",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"upload_source_maps": true,
	"assets": {
		"binding": "ASSETS",
		"directory": "./public",
		"run_worker_first": ["/"]
	},
	"vars": {
		"ROUTE_ADDRESS": "info@ladlab.uk",
		"FORWARD_TO": "ladiran@gmail.com",
		"ALLOWED_SENDERS": "abimbola.oladiran@science.fulafia.edu.ng, ladiran001@gmail.com"
	},
	// Uncomment this top-level section after replacing the example address.
	// Each entry creates an Email Routing rule managed by Wrangler.
	"addresses": [
	 	"support@ladlab.uk"
	// 	// Use "*@company.example" instead to route every unmatched address.
	 ],
	"observability": {
		"enabled": true
	}
}
